Notebook[{

Cell[CellGroupData[{
Cell["Exercises", "Section",
 CellChangeTimes->{{3.908958487908535*^9, 
  3.9089584912693567`*^9}},ExpressionUUID->"03354471-cd10-46ac-bc3a-\
0d1fde5c27a3"],

Cell[TextData[{
 "For the exam complete two of these... \n\nQ1: Write the expression f(x)= x ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "x"}]], TraditionalForm]],ExpressionUUID->
  "6cd20a03-f019-4c89-94ce-f92546f10822"],
 " + x (1 - x), and evaluate it at the points x=0, 0.1, 0.2, 0.4, 0.8."
}], "Text",
 CellChangeTimes->{{3.9102406962113647`*^9, 3.910240752399127*^9}, {
  3.910761975180615*^9, 3.910761983281179*^9}, {4.001127808747937*^9, 
  4.001127834129406*^9}},ExpressionUUID->"613b91ed-b215-4ef0-8871-\
4aeff5b81c67"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "f", "]"}], "\n", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"x", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", "x"}], "]"}]}], "+", 
   RowBox[{"x", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}]}]}]}]}], "Input",
 CellChangeTimes->{{4.001127988769207*^9, 4.00112802972714*^9}, {
  4.0011281558902903`*^9, 4.001128161283277*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"3149b4b2-096c-4605-919b-6ca083bfed07"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"f", "[", "0", "]"}], "\n", 
 RowBox[{"f", "[", "0.1", "]"}], "\n", 
 RowBox[{"f", "[", "0.2", "]"}], "\n", 
 RowBox[{"f", "[", "0.4", "]"}], "\n", 
 RowBox[{"f", "[", "0.8", "]"}]}], "Input",
 CellChangeTimes->{4.001128041604744*^9, 4.001128191143763*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"e033b5d3-fa48-45c6-81ca-5f8f9293b4c5"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{4.001128042733988*^9, 4.001128191899819*^9, 
  4.001183240027444*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"f6e2fa4f-00c4-4c23-b834-7f3a1ef496b8"],

Cell[BoxData["0.18048374180359597`"], "Output",
 CellChangeTimes->{4.001128042733988*^9, 4.001128191899819*^9, 
  4.00118324002923*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"10d2d014-2b89-417d-93ba-10222d0d2ba3"],

Cell[BoxData["0.3237461506155964`"], "Output",
 CellChangeTimes->{4.001128042733988*^9, 4.001128191899819*^9, 
  4.001183240030308*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"ffc6932b-40a3-4af2-b796-f2908f03b90a"],

Cell[BoxData["0.5081280184142558`"], "Output",
 CellChangeTimes->{4.001128042733988*^9, 4.001128191899819*^9, 
  4.001183240031258*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"02906e24-bb0e-4f73-bbac-24a452ee1df0"],

Cell[BoxData["0.5194631712937772`"], "Output",
 CellChangeTimes->{4.001128042733988*^9, 4.001128191899819*^9, 
  4.001183240032249*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"db517f54-3741-4fad-bc09-f47e7a110a38"]
}, Open  ]],

Cell[TextData[{
 "Q3: Integrate the expression f(x) = sin(x) ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "x"}]], TraditionalForm]],ExpressionUUID->
  "69649aeb-f6f2-4a33-8f79-252c6877a5c4"],
 ", and then take its derivative."
}], "Text",
 CellChangeTimes->{{3.9102408807548604`*^9, 
  3.910240905162507*^9}},ExpressionUUID->"cd159cfc-7b9e-4a17-a559-\
a59c737ba501"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "f", "]"}], "\n", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"-", "x"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{4.001128290095495*^9, 4.0011282930438633`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"5a7111ad-7093-4117-bcb6-60aa8196c098"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{4.001128306251131*^9},
 CellLabel->"In[10]:=",ExpressionUUID->"c7fc550b-b717-4a88-a57b-e031954e5b1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", "2"]}], " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", "x"}]], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Cos", "[", "x", "]"}], "+", 
    RowBox[{"Sin", "[", "x", "]"}]}], ")"}]}]], "Output",
 CellChangeTimes->{4.001128307668518*^9, 4.0011832488227577`*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"52b833a6-a0ea-447f-9edd-e4956b170431"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D", "[", 
  RowBox[{"%", ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{4.0011283260231752`*^9, 4.001128326023746*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"1822b6e1-6f24-4e8b-9b9a-f2db76dcffed"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    FractionBox["1", "2"]}], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", "x"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], "-", 
     RowBox[{"Sin", "[", "x", "]"}]}], ")"}]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", "x"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], "+", 
     RowBox[{"Sin", "[", "x", "]"}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{4.0011283268634987`*^9, 4.001183251183076*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"134e324d-636c-4aea-a1b1-8f480d444b15"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", "%", "]"}]], "Input",
 CellChangeTimes->{{4.001128405023163*^9, 4.001128405024682*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"0f37a867-15e7-4fb9-90f1-0ea1e1fe2025"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", "x"}]], " ", 
  RowBox[{"Sin", "[", "x", "]"}]}]], "Output",
 CellChangeTimes->{4.001128405553117*^9, 4.001183253308525*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"4cfa627f-4d66-4b1e-8c7b-85f15e68f080"]
}, Open  ]]
}, Open  ]],

